# services/ai 환경변수 샘플. 이 파일을 복사해 services/ai/.env 를 만들고 값을 채운다.
# .env 는 git에 올리지 않는다 (.gitignore). 키를 이 샘플 파일에 직접 적지 않는다.
# 앱이 시작할 때 이 폴더의 .env 를 스스로 읽는다 (--env-file 불필요). 고친 뒤에는 서버를 재시작한다.

# 로컬 Ollama. https://ollama.com 에서 설치하고 `ollama serve`로 띄운다.
# 서버에 연결 못 하면 POST /infer 가 503을 돌려준다.
OLLAMA_BASE_URL=http://localhost:11434
# 미리 `ollama pull`로 받아 둔 모델 태그. 생략하면 코드 기본값(gemma4:e4b)을 쓴다.
# 보유 모델 확인: `ollama list`
OLLAMA_MODEL=gemma4:e4b
# Ollama는 스트리밍으로 부른다. 아래 제한은 "토큰 사이 공백"에만 걸린다(초, 0이면 없음). 느린 서버·큰 모델이면 늘린다
# OLLAMA_READ_TIMEOUT_SECONDS=600
# 무료 호스팅 API로 대화한다 (PC·GPU 없이). OpenAI 호환 주소. 키는 이 파일에만 적는다
# LLM_BACKEND=openai
# LLM_API_BASE=https://integrate.api.nvidia.com/v1
# LLM_API_MODEL=google/gemma-4-31b-it
# LLM_API_KEY=
# API가 막히면(한도·서버 오류·시간 초과) 위 Ollama로 대신 답한다
# LLM_FALLBACK_OLLAMA=1
# 글로 답하는 호출은 스트리밍: 조각 사이 공백(초)·전체 상한(초). 첫 조각 전에 막힐 때만 예비로 넘어간다
# LLM_API_READ_TIMEOUT_SECONDS=40
# LLM_API_TOTAL_TIMEOUT_SECONDS=150
# CPU 예비를 가볍게 (최근 대사 수 · 출력 토큰). 뒤에서 하는 정리(X-AI-Priority: background)는 예비로 가지 않는다
# LLM_FALLBACK_MAX_TURNS=8
# LLM_FALLBACK_MAX_TOKENS=320
# 기동 때 대화 모델을 미리 올린다 (배포용. 모델 유지 시간은 Ollama 쪽 OLLAMA_KEEP_ALIVE)
# OLLAMA_WARMUP=1

# 프리미엄 모델(실제 돈이 나간다). 키는 이 파일에만 적는다. 열지 말지는 Nest의 PREMIUM_PROVIDERS·PREMIUM_MONTHLY_CREDITS가 정한다
# ANTHROPIC_API_KEY=
# XAI_API_KEY=

# Nest와 공유하는 내부 호출 토큰. 비우면 루프백(127.0.0.1)만 받는다. 값이 있으면 모든 요청에 헤더 X-AI-Token 이 있어야 한다.
# 운영(APP_ENV=production)에서는 32자 이상이어야 시작하고, LLM_FAKE·IMAGE_FAKE 가 켜져 있으면 시작하지 않는다.
# AI_SERVICE_TOKEN=
# APP_ENV=production

# --- 시험용 (실제 대화에서는 켜지 않는다. 켜면 모델 없이 고정된 가짜 답만 나온다) ---
# 웹 자동 테스트(npm run test:e2e)가 자동으로 켠다. 직접 켤 일은 거의 없다.
# LLM_FAKE=1
# 가짜 LLM이 한 번 답하는 데 걸리는 시간(ms). 부하 측정(npm run bench)에서 느린 모델을 흉내 낼 때
# FAKE_LLM_DELAY_MS=1500
# 1이면 여러 요청이 와도 한 번에 하나만 처리(로컬 Ollama 한 대처럼)
# FAKE_LLM_SERIAL=1

# 기억·공통 말투 벡터 저장 위치. 비우면 services/ai/app/data/ChromaDB. 사용자 글이 들어가므로 커밋하지 않는다
# CHROMA_DIR=
