# services/ai 환경변수 샘플. 이 파일을 복사해 services/ai/.env 를 만들고 값을 채운다.
# .env 는 git에 올리지 않는다 (.gitignore). 키를 이 샘플 파일에 직접 적지 않는다.
# 앱이 시작할 때 이 폴더의 .env 를 스스로 읽는다 (--env-file 불필요). 고친 뒤에는 서버를 재시작한다.

# 호스티드 LLM (Google Gemini). Google AI Studio(https://aistudio.google.com/apikey)에서 발급한다.
# 비어 있으면 POST /infer 가 503을 돌려준다.
GEMINI_API_KEY=
# 생략하면 코드 기본값(gemini-3.8-flash)을 쓴다.
GEMINI_MODEL=gemini-3.8-flash
