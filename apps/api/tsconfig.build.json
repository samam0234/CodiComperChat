{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // 증분 빌드 기록을 출력 폴더 안에 둔다. nest의 deleteOutDir나 다른 빌드가 dist를 지우면
    // 기록도 함께 지워져 전부 다시 출력한다. 밖에 두면 "이미 출력함"으로 착각해 main.js를
    // 다시 쓰지 않고, dev 서버가 "Cannot find module dist/main"으로 멈춘 채 살아나지 않는다
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
