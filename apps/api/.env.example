# 로컬 PostgreSQL 기준값 (docs/guidance/docker-run.md). Docker postgres를 쓰면 docker-compose.yml과 맞춘다.
DATABASE_URL="postgresql://codicomperchat:codicomperchat@localhost:5432/codicomperchat?schema=public"

# Nest가 FastAPI(services/ai)를 호출할 주소. 생략하면 http://localhost:8000
# LLM 키(GEMINI_API_KEY)는 여기가 아니라 services/ai/.env 에 둔다 — 키를 읽는 쪽은 FastAPI다.
AI_BASE_URL=http://localhost:8000
# AI(모델) 동시 호출 수 (API 서버 한 대 기준). 모델이 한 번에 하나만 처리하면 1~2, 병렬 처리가 되면 키운다.
# 서버가 여러 대면 모델이 받는 동시 호출은 "서버 대수 × 이 값"이다 — 모델 한 대를 나눠 쓰면 대수로 나눠 정한다
AI_CONCURRENCY=2

# 로그인 토큰 서명 키 (32자 이상, 필수 — 없으면 api가 시작하지 않는다). 사람마다 새로 만든다:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 노출되면 누구나 로그인 토큰을 위조할 수 있다. 실제 값은 .env 에만 둔다.
AUTH_SECRET=

# 캐릭터 페르소나 지식 RAG (apps/api/data/personas/README.md). 기본은 켜짐.
# off 로 두면 지식 JSON을 무시하고 카드 원문 전부를 모델에 넘긴다 (효과를 비교할 때)
# PERSONA_RAG=off
# 지식 JSON 폴더를 바꾸고 싶을 때만. 생략하면 apps/api/data/personas
# PERSONA_DATA_DIR=

# 요청 한도(로그인 시도·LLM 호출·업로드·신고). 기본은 켜짐 (docs/API_DOCUMENTATION.md "요청 한도")
# RATE_LIMIT=off          # 끄기 (개발 중 한도에 걸릴 때만)
# RATE_LIMIT_SCALE=3      # 한도에 곱할 수 (예: 3배)
# RATE_LIMIT_STORE=db     # API 서버가 여러 대일 때: 카운터를 PostgreSQL(rate_limit_buckets)에 두고 함께 센다. 기본 memory

# 메일 발송 (이메일 인증·비밀번호 찾기). 없으면 개발 중에는 서버 로그에 메일 내용(링크)이 찍힌다
# MAIL_SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="코디컴퍼챗 <no-reply@example.com>"
# 메일 속 링크가 가리킬 웹 주소. 생략하면 http://localhost:3000
# WEB_BASE_URL=http://localhost:3000
# MAIL_OUTBOX_DIR=     # 보내지 않고 이 폴더에 JSON으로 남김 (자동 테스트용)

# 결제 (요금 등급). 없으면 개발 중에는 돈이 오가지 않는 가짜 결제, 운영에서는 결제를 열지 않는다
# BILLING_PROVIDER=toss     # toss | mock
# TOSS_SECRET_KEY=          # 서버 승인용 비밀 키. 실제 값은 .env 에만
# TOSS_CLIENT_KEY=          # 웹 결제창용 공개 키
# BILLING_PRICE_PRO_30=4900     # 상품 가격(원). 없으면 기본값
# BILLING_PRICE_PRO_365=49000
# 키 확인: npm run billing:check --workspace api
