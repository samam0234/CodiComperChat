// 코디컴퍼챗 Prisma 스키마
// 원본: CodiComperChat_project_plan.md §10 2번 "Prisma 스키마: User, Character, Campaign, Session, Message, State"
// 테이블명 확정은 Prisma 단계에서 한다 (계획서 §7.5). 여기서는 core 6모델만 다룬다.
// LoreEntry / MemoryChunk는 §10 2번 범위 밖 — 이후 단계에서 추가한다.

generator client {
  provider = "prisma-client-js"
}

// 연결 문자열은 schema.prisma가 아니라 prisma.config.ts에서 관리한다 (Prisma 7)
datasource db {
  provider = "postgresql"
}

/// 운영자만 캐릭터를 발행한다 — v1 공방은 운영 도구다 (기획서 §5.4, 유저 광장은 v1 밖 §9.2)
enum UserRole {
  USER
  ADMIN
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  displayName  String
  // 소셜 로그인 등 비밀번호 없는 계정도 담을 수 있게 nullable (인증 벤더 미정)
  passwordHash String?
  role         UserRole         @default(USER)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  campaigns    Campaign[]
  personas     UserPersona[]
  drafts       CharacterDraft[]

  @@map("users")
}

// 유저가 연기하는 주인공(프로필 캐릭터). 본인만 보고 쓴다 — 공유·마켓은 v1 범위 밖 (기획서 §9.2)
model UserPersona {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("user_personas")
}

/// 캐릭터 카드. 필드는 계획서 §12.2 카드 핵심 항목과 1:1로 대응한다.
model Character {
  id                    String          @id @default(cuid())
  name                  String          @unique
  oneLiner              String
  role                  String
  addressing            String
  personalityAxes       String
  speechStyle           String
  knows                 String
  unknown               String
  goal                  String
  conflictSeed          String
  secret                String
  secretUnlockCondition String
  openingScene          String
  /// 신체·직업 등 카드 밖 부가 프로필. 캐릭터마다 있을 수도, 없을 수도 있다
  profile               Json?
  published             Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  campaigns             Campaign[]
  /// 공방에서 만들어 발행한 캐릭터면 그 초안
  draft                 CharacterDraft?

  @@map("characters")
}

enum CampaignStatus {
  ACTIVE
  CLOSED
}

model Campaign {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId        String
  character          Character      @relation(fields: [characterId], references: [id])
  title              String
  status             CampaignStatus @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  state              CampaignState?
  sessions           Session[]
  memories           MemoryChunk[]
  /// 이 대화에서 쓰는 내 프로필. 첫 메시지 때 정해지고 새로하기 전까지 바꿀 수 없다.
  /// 프로필을 나중에 고치거나 지워도 대화가 흔들리지 않게 이름·소개를 함께 남긴다
  personaId          String?
  personaName        String?
  personaDescription String?
  /// 새로하기·이어하기에서 저장한 시각 (status CLOSED = 저장한 대화)
  savedAt            DateTime?
  /// 이 시각까지의 메시지는 기억으로 정리했다. 그 뒤 메시지가 쌓이면 다음 정리를 한다
  memorizedUntil     DateTime?

  // 유저×캐릭터의 지금 대화(ACTIVE 하나)와 저장한 대화(CLOSED 여럿)를 찾는 경로
  @@index([userId, characterId, status])
  @@map("campaigns")
}

/// §13.3~13.4 캠페인 상태 — 관계·훅·다음 회차 브리핑
model CampaignState {
  id                  String   @id @default(cuid())
  campaignId          String   @unique
  campaign            Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// 친밀도 0(처음 만남)~100(각별함). 유저가 캐릭터 상태설정에서 조정한다
  relationshipValue   Int      @default(0)
  relationshipNote    String?
  /// 이 대화에서 캐릭터가 유저를 부르는 호칭. 비어 있으면 캐릭터 카드의 호칭 규칙을 따른다
  userNickname        String?
  openHooks           Json     @default("[]")
  unlockedSecrets     Json     @default("[]")
  briefForNextSession String?
  updatedAt           DateTime @updatedAt

  @@map("campaign_states")
}

enum SessionStatus {
  OPEN
  CLOSED
}

model Session {
  id           String        @id @default(cuid())
  campaignId   String
  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  index        Int
  status       SessionStatus @default(OPEN)
  startedAt    DateTime      @default(now())
  closedAt     DateTime?
  summaryBrief String?
  messages     Message[]

  @@unique([campaignId, index])
  @@map("sessions")
}

enum MessageRole {
  USER
  CHARACTER
  SYSTEM
}

model Message {
  id        String      @id @default(cuid())
  sessionId String
  session   Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  /// 유저 메시지를 보낼 때 쓴 내 프로필 캐릭터 이름 (프로필을 나중에 지우거나 바꿔도 기록은 그대로 남긴다)
  speaker   String?
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
  @@map("messages")
}

/// §7.5 MemoryChunk — 지난 대화에서 캐릭터가 기억할 내용을 요약한 짧은 문장.
/// 원문(Message)과 분리해 두고, 매 턴 관련 있는 것만 골라 컨텍스트에 넣는다. 임베딩은 나중에 붙인다
model MemoryChunk {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())

  @@index([campaignId, createdAt])
  @@map("memory_chunks")
}

/// 캐릭터 공방 초안 (기획서 §4.1 카드 7층, §6 공방). 카드 전체를 JSON으로 두고,
/// 발행하면 Character 행과 페르소나 지식 JSON(apps/api/data/personas, git 제외)으로 내보낸다
model CharacterDraft {
  id          String     @id @default(cuid())
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  card        Json
  /// 마지막 3턴 테스트 결과와 그때의 카드 지문. 카드를 고치면 지문이 달라져 다시 테스트해야 발행된다
  lastTest    Json?
  characterId String?    @unique
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([ownerId, updatedAt])
  @@map("character_drafts")
}
