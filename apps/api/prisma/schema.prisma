// 코디컴퍼챗 Prisma 스키마
// 원본: CodiComperChat_project_plan.md §10 2번 "Prisma 스키마: User, Character, Campaign, Session, Message, State"
// 테이블명 확정은 Prisma 단계에서 한다 (계획서 §7.5). 여기서는 core 6모델만 다룬다.
// LoreEntry / MemoryChunk는 §10 2번 범위 밖 — 이후 단계에서 추가한다.

generator client {
  provider = "prisma-client-js"
}

// 연결 문자열은 schema.prisma가 아니라 prisma.config.ts에서 관리한다 (Prisma 7)
datasource db {
  provider = "postgresql"
}

/// 운영자만 캐릭터를 발행한다 — v1 공방은 운영 도구다 (기획서 §5.4, 유저 광장은 v1 밖 §9.2)
enum UserPlan {
  FREE
  PRO
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  // 소셜 로그인 등 비밀번호 없는 계정도 담을 수 있게 nullable (인증 벤더 미정)
  passwordHash String?
  role         UserRole @default(USER)

  /// 요금 등급. 결제는 아직 없어 운영자가 부여한다(npm run user:plan). PRO면 긴 글 칸 글자 수가 3배

  plan UserPlan @default(FREE)

  /// PRO 만료 시각. 비어 있으면 만료 없음. 지나면 FREE로 본다

  planUntil  DateTime?

  /// 이메일 인증을 마친 시각. 비어 있으면 미인증 (캐릭터 공개 발행은 인증 뒤에만)

  emailVerifiedAt DateTime?
  /// 성인 확인 (코디포토넷 NSFW). 2026-10-24 임시 방식: 생년월일(만 19세 이상) + 성인 콘텐츠 동의 + 이메일 인증.
  /// 실제 공개 전에는 본인인증(PASS 등)으로 바꿔야 한다 (docs/guidance/photonet-engine.md). 생년월일은 응답에 싣지 않는다
  birthDate       DateTime? @db.Date
  adultConsentAt  DateTime?

  /// 로그인 토큰 세대. 비밀번호를 바꾸거나 재설정하면 1 올려 이전에 발급한 토큰을 모두 무효로 만든다

  sessionVersion Int @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  campaigns  Campaign[]
  personas   UserPersona[]
  drafts     CharacterDraft[]
  extras     UserExtra[]
  characters Character[]

  reports CharacterReport[]

  emailTokens EmailToken[]

  orders PaymentOrder[]
  modelUsage ModelUsage[]
  /// 코레딧 잔액 (src/credits/credits.ts). 바뀔 때마다 credit_ledger에 한 줄 남긴다
  credits     Int             @default(0)
  creditLedger CreditLedger[]
  attendances  Attendance[]
  questRewards QuestReward[]

  @@map("users")
}

// 유저가 연기하는 주인공(프로필 캐릭터). 본인만 보고 쓴다 — 공유·마켓은 v1 범위 밖 (기획서 §9.2)
model UserPersona {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("user_personas")
}

/// 캐릭터 카드. 필드는 계획서 §12.2 카드 핵심 항목과 1:1로 대응한다.
model Character {
  id                    String              @id @default(cuid())
  name                  String              @unique
  oneLiner              String
  role                  String
  addressing            String
  personalityAxes       String
  speechStyle           String
  knows                 String
  unknown               String
  goal                  String
  conflictSeed          String
  secret                String
  secretUnlockCondition String
  openingScene          String
  /// 비밀 퀘스트(제목·건네는 부탁·달성 조건·보상 장면·열리는 친밀도). 공개 응답에는 싣지 않는다. 없으면 퀘스트 없는 캐릭터
  quest                 Json?
  /// 이 캐릭터와 대화할 때 추천하는 내 프로필 { name, description } (선택). 유저가 그대로 쓰거나 고쳐서 내 프로필로 만든다
  recommendedPersona    Json?
  /// 신체·직업 등 카드 밖 부가 프로필. 캐릭터마다 있을 수도, 없을 수도 있다
  profile               Json?
  published             Boolean             @default(false)
  /// 공개: 홈·인기 목록에 나온다 / 링크 공개: 목록에는 없고 주소를 아는 사람만 / 비공개: 만든 사람만
  visibility            CharacterVisibility @default(PUBLIC)
  /// 공방에서 발행한 사람. 운영 캐릭터는 비어 있다. 계정이 지워지면 비워지고, 비공개 캐릭터는 아무도 못 보게 된다
  /// 운영자가 내린 시각. 값이 있으면 목록·상세·대화 어디에도 나오지 않는다(만든 사람은 공방에서 사유를 본다)

  /// 흉상 초상 이미지(공방에서 올린 것). 목록 조회에는 싣지 않고 portraitMime만 본다

  portrait Bytes?

  portraitMime String?

  takenDownAt DateTime?

  takedownReason String?

  ownerId   String?
  owner     User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  campaigns Campaign[]
  /// 공방에서 만들어 발행한 캐릭터면 그 초안
  draft     CharacterDraft?

  reports CharacterReport[]

  @@map("characters")
}

enum CharacterVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum CampaignStatus {
  ACTIVE
  CLOSED
}

model Campaign {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId        String
  character          Character       @relation(fields: [characterId], references: [id])
  title              String
  status             CampaignStatus  @default(ACTIVE)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  state              CampaignState?
  sessions           Session[]
  memories           MemoryChunk[]
  extras             CampaignExtra[]
  /// 이 대화에서 쓰는 내 프로필. 첫 메시지 때 정해지고 새로하기 전까지 바꿀 수 없다.
  /// 프로필을 나중에 고치거나 지워도 대화가 흔들리지 않게 이름·소개를 함께 남긴다
  personaId          String?
  personaName        String?
  personaDescription String?
  /// 새로하기·이어하기에서 저장한 시각 (status CLOSED = 저장한 대화)
  savedAt            DateTime?
  /// 이 시각까지의 메시지는 기억으로 정리했다. 그 뒤 메시지가 쌓이면 다음 정리를 한다
  memorizedUntil     DateTime?
  /// 이 대화의 답을 쓰는 모델 (src/models/models.ts의 id). 새 대화는 기본 무료 모델
  chatModel          String          @default("basic")
  /// 오퍼레이션(대화 플러그인) 기록. 대화를 지우면 함께 지워진다
  mindReadings       MindReading[]
  diaryEntries       DiaryEntry[]
  directMessages     DirectMessage[]
  boardPosts         BoardPost[]
  photonetImages     PhotonetImage[]
  webtoons           Webtoon[]

  // 유저×캐릭터의 지금 대화(ACTIVE 하나)와 저장한 대화(CLOSED 여럿)를 찾는 경로
  @@index([userId, characterId, status])
  @@map("campaigns")
}

/// §13.3~13.4 캠페인 상태 — 관계·훅·다음 회차 브리핑
model CampaignState {
  id                  String    @id @default(cuid())
  campaignId          String    @unique
  campaign            Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// 친밀도 0(처음 만남)~100(각별함). 유저가 캐릭터 상태설정에서 조정한다
  relationshipValue   Int       @default(0)
  relationshipNote    String?
  /// 이 대화에서 캐릭터가 유저를 부르는 호칭. 비어 있으면 캐릭터 카드의 호칭 규칙을 따른다
  userNickname        String?
  openHooks           Json      @default("[]")
  unlockedSecrets     Json      @default("[]")
  briefForNextSession String?
  /// 대화에 따라 친밀도가 자동으로 바뀌게 할지 (유저가 끌 수 있다)
  autoRelationship    Boolean   @default(true)
  /// 자동 변화의 근거 한 줄과 최근 기록 [{ at, delta, value, reason }] (최근 10개)
  relationshipReason  String?
  relationshipLog     Json      @default("[]")
  /// 이미 끝난 일(문장 목록, 최근 20개). 모델이 다시 되돌리지 못하게 프롬프트에 넣는다
  closedEvents        Json      @default("[]")
  /// 이 시각까지의 메시지는 이야기 상태(요약·친밀도·복선)에 반영했다
  digestedUntil       DateTime?
  /// 비밀 퀘스트 진행 { status: offered|done, at } — 아직 건네지 않았으면 비어 있다
  questState          Json?
  updatedAt           DateTime  @updatedAt

  @@map("campaign_states")
}

enum SessionStatus {
  OPEN
  CLOSED
}

model Session {
  id           String        @id @default(cuid())
  campaignId   String
  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  index        Int
  status       SessionStatus @default(OPEN)
  startedAt    DateTime      @default(now())
  closedAt     DateTime?
  summaryBrief String?
  messages     Message[]

  @@unique([campaignId, index])
  @@map("sessions")
}

enum MessageRole {
  USER
  CHARACTER
  SYSTEM
}

model Message {
  id        String      @id @default(cuid())
  sessionId String
  session   Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  /// 유저 메시지를 보낼 때 쓴 내 프로필 캐릭터 이름 (프로필을 나중에 지우거나 바꿔도 기록은 그대로 남긴다)
  speaker   String?
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
  @@map("messages")
}

/// §7.5 MemoryChunk — 지난 대화에서 캐릭터가 기억할 내용을 요약한 짧은 문장.
/// 원문(Message)과 분리해 두고, 매 턴 관련 있는 것만 골라 컨텍스트에 넣는다. 임베딩은 나중에 붙인다
model MemoryChunk {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())

  @@index([campaignId, createdAt])
  @@map("memory_chunks")
}

/// 캐릭터 공방 초안 (기획서 §4.1 카드 7층, §6 공방). 카드 전체를 JSON으로 두고,
/// 발행하면 Character 행과 페르소나 지식 JSON(apps/api/data/personas, git 제외)으로 내보낸다
model CharacterDraft {
  id           String              @id @default(cuid())
  ownerId      String
  owner        User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  card         Json
  /// 마지막 3턴 테스트 결과와 그때의 카드 지문. 카드를 고치면 지문이 달라져 다시 테스트해야 발행된다
  lastTest     Json?
  /// 흉상 초상 이미지 (webp·jpeg·png, 150KB 이하). 발행하면 캐릭터에도 실린다
  portrait     Bytes?
  portraitMime String?
  /// 초상 검수 결과. 승인된 초상만 캐릭터에 실려 남에게 보인다(기다리는 중·반려면 캐릭터에는 초상이 없다)
  portraitReview     PortraitReview?
  /// 자동 검수가 운영자에게 넘긴 이유, 또는 운영자의 반려 사유
  portraitReviewNote String?
  /// 발행할 때(또는 발행 중이면 바로) 캐릭터에 적용할 공개 범위
  visibility   CharacterVisibility @default(PRIVATE)
  characterId  String?             @unique
  character    Character?          @relation(fields: [characterId], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([ownerId, updatedAt])
  @@map("character_drafts")
}

/// 엑스트라: 유저가 만든 조연. 캐릭터 공방보다 간단한 카드이고, 대화마다 골라서 적용한다
model UserExtra {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  summary     String
  personality String
  /// 주인공 캐릭터·유저와의 관계 (인물 관계 조건의 단어가 여기서 나온다)
  relation    String
  /// 등장 상황 (상황 조건)
  situation   String
  /// 등장 장소 (장소 조건)
  place       String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  campaigns   CampaignExtra[]

  @@index([userId, updatedAt])
  @@map("user_extras")
}

/// 이 대화에 적용한 엑스트라와 등장 조건(relation/situation/place 중 하나 이상).
/// 조건에 맞는 말이 대화에 나올 때만 그 엑스트라 정보를 모델에 넘긴다 (환각 방지)
model CampaignExtra {
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  extraId    String
  extra      UserExtra @relation(fields: [extraId], references: [id], onDelete: Cascade)
  triggers   String[]
  createdAt  DateTime  @default(now())

  @@id([campaignId, extraId])
  @@map("campaign_extras")
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// 공개·링크 공개 캐릭터에 대한 신고. 운영자가 보고 캐릭터를 내리거나(RESOLVED) 기각한다(DISMISSED)
model CharacterReport {
  id          String       @id @default(cuid())
  characterId String
  character   Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  reporterId  String
  reporter    User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  /// SEXUAL · VIOLENCE · HATE · PRIVACY · COPYRIGHT · SPAM · OTHER
  reason      String
  detail      String
  status      ReportStatus @default(OPEN)
  /// 처리 때 운영자가 남긴 말(캐릭터 주인에게도 보인다)
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([status, createdAt])
  @@index([characterId, status])
  @@map("character_reports")
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// 메일로 보낸 일회용 링크 토큰. 원문은 메일에만 있고 DB에는 SHA-256 해시만 둔다
model EmailToken {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   EmailTokenPurpose
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, purpose])
  @@map("email_tokens")
}

/// 초상 검수 상태. 자동 검수가 통과시키면 APPROVED, 애매하거나 검수를 못 하면 PENDING(운영자 확인), 운영자가 거절하면 REJECTED
enum PortraitReview {
  APPROVED
  PENDING
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// 요금 등급 결제 주문. 결제창을 열기 전에 만들고(금액을 서버가 정한다), 결제사 승인이 끝나면 PAID로 바꾸며 등급 기간을 늘린다
model PaymentOrder {
  /// 결제사에 넘기는 주문 번호
  id          String        @id @default(cuid())
  /// 탈퇴하면 비워진다. 결제 기록은 전자상거래법에 따라 정해진 기간 남겨야 해서 주문은 지우지 않는다
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// 결제할 때의 구매자 이메일 (탈퇴 뒤에도 결제 기록을 확인할 수 있게 남긴다)
  buyerEmail  String?
  /// 상품 코드 (apps/api/src/billing/products.ts)
  productId   String
  /// 원 단위 금액. 승인할 때 결제사가 돌려준 금액과 맞아야 한다
  amount      Int
  /// 결제하면 늘어나는 프로 등급 일수
  days        Int
  /// toss | mock(개발·시험용 가짜 결제)
  provider    String
  status      PaymentStatus @default(PENDING)
  /// 결제사가 준 결제 키 (승인·취소 조회에 쓴다)
  paymentKey  String?       @unique
  failReason  String?
  /// 결제사 영수증 주소 (토스 승인 응답의 receipt.url)
  receiptUrl  String?
  /// 환불한 시각과 사유 (운영자가 처리)
  refundedAt  DateTime?
  refundReason String?
  createdAt   DateTime      @default(now())
  paidAt      DateTime?

  @@index([userId, createdAt])
  @@map("payment_orders")
}

/// 요청 한도 카운터 (RATE_LIMIT_STORE=db일 때). API 서버가 여러 대여도 같은 한도를 나눠 쓰게 DB에 둔다.
/// 고정 창: resetAt이 지나면 처음부터 센다. 지난 창은 주기적으로 지운다
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

/// 하루 횟수가 있는 모델(강화 무료)의 사용 횟수. day는 한국 시각 기준 YYYY-MM-DD
model ModelUsage {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelId String
  day     String
  count   Int    @default(0)

  @@id([userId, modelId, day])
  @@index([day])
  @@map("model_usage")
}

enum CreditReason {
  ATTENDANCE
  MODEL_USE
  REFUND
  ADMIN
  /// 오퍼레이션(심리 탐구·일기·커뮤니티·코디포토넷·웹툰)에 쓴 것. modelId 칸에 "op:이름"
  OPERATION
  /// 비밀 퀘스트 보상(공식 캐릭터만). modelId 칸에 "quest:캐릭터 id"
  QUEST
}

/// 비밀 퀘스트 코레딧 보상을 받은 기록. 계정×캐릭터당 한 번 — 새로하기로 다시 깨도 또 주지 않는다
model QuestReward {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId String
  amount      Int
  createdAt   DateTime @default(now())

  @@unique([userId, characterId])
  @@map("quest_rewards")
}

/// 코레딧이 늘고 준 기록. balance는 이 줄을 반영한 뒤의 잔액
model CreditLedger {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  balance   Int
  reason    CreditReason
  /// 모델을 쓰거나 돌려받았을 때 그 모델 id
  modelId   String?
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
  @@map("credit_ledger")
}

/// 출석 (하루 한 번). day는 한국 시각 기준 YYYY-MM-DD
model Attendance {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String
  credits   Int
  createdAt DateTime @default(now())

  @@id([userId, day])
  @@map("attendances")
}

/// 오퍼레이션 · 심리 탐구: 그 순간 캐릭터의 속마음 (진행 중인 대화의 최근 장면을 바탕으로)
model MindReading {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  innerVoice String
  feeling    String
  aboutUser  String
  createdAt  DateTime @default(now())

  @@index([campaignId, createdAt])
  @@map("mind_readings")
}

/// 오퍼레이션 · 일기: 캐릭터가 자기 입장에서 쓰는 일기 (최근 대화에서 겪은 일과 기분)
model DiaryEntry {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title      String
  mood       String
  body       String
  createdAt  DateTime @default(now())

  @@index([campaignId, createdAt])
  @@map("diary_entries")
}

/// 오퍼레이션 · 메시지: 대화(롤플레이)와 따로 주고받는 짧은 문자. 기억·관계는 대화와 함께 쓴다
model DirectMessage {
  id         String      @id @default(cuid())
  campaignId String
  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  role       MessageRole
  content    String
  createdAt  DateTime    @default(now())

  @@index([campaignId, createdAt])
  @@map("direct_messages")
}

/// 커뮤니티 글쓴이: 나(유저) / 그 세계의 주민(AI)
enum BoardAuthor {
  USER
  RESIDENT
}

/// 오퍼레이션 · 커뮤니티: 캐릭터 세계 속 가상 익명 게시판의 글. 이 대화를 하는 사람에게만 보인다(다른 유저와 나누지 않는다)
model BoardPost {
  id         String         @id @default(cuid())
  campaignId String
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  authorKind BoardAuthor
  /// 화면에 보이는 글쓴이 (익명·주민 닉네임·내 주인공 실명)
  authorName String
  title      String
  body       String
  createdAt  DateTime       @default(now())
  comments   BoardComment[]

  @@index([campaignId, createdAt])
  @@map("board_posts")
}

model BoardComment {
  id         String      @id @default(cuid())
  postId     String
  post       BoardPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorKind BoardAuthor
  authorName String
  body       String
  createdAt  DateTime    @default(now())

  @@index([postId, createdAt])
  @@map("board_comments")
}

/// 코디포토넷: 대화 장면으로 만든 그림 (그림 검수를 통과한 것만 남는다). 이 대화를 하는 사람에게만 보인다
model PhotonetImage {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// 유저가 쓴 장면 설명
  prompt     String
  /// 엔진에 실제로 보낸 영어 프롬프트
  promptUsed String
  style      String
  ratio      String
  /// sfw: 전체 이용가 / nsfw: 성인 (성인 확인한 사람에게만 보인다)
  rating     String   @default("sfw")
  mime       String
  data       Bytes
  width      Int
  height     Int
  createdAt  DateTime @default(now())

  @@index([campaignId, createdAt])
  @@map("photonet_images")
}

/// 웹툰 (오퍼레이션): 대화를 여러 컷으로. 콘티(컷마다 장면 설계·해설·대사)를 먼저 쓰고, 컷은 하나씩 그린다(한 컷 45 코레딧)
model Webtoon {
  id         String         @id @default(cuid())
  campaignId String
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title      String
  /// 유저가 쓴 장면 설명(또는 고른 대사)
  prompt     String
  /// sfw: 전체 이용가 / nsfw: 성인 (성인 확인한 사람에게만 보인다)
  rating     String         @default("sfw")
  createdAt  DateTime       @default(now())
  panels     WebtoonPanel[]

  @@index([campaignId, createdAt])
  @@map("webtoons")
}

/// 웹툰 한 컷. 그림은 그린 뒤에만 있다(실패하면 비어 있고 다시 그릴 수 있다)
model WebtoonPanel {
  id         String   @id @default(cuid())
  webtoonId  String
  webtoon    Webtoon  @relation(fields: [webtoonId], references: [id], onDelete: Cascade)
  index      Int
  /// 장면 설계표(사람·장소·행동·빛·구도) — 그릴 때 프롬프트로 조립한다
  plan       Json
  /// 해설(나레이션 상자)과 대사 [{ speaker, text }]
  caption    String
  lines      Json     @default("[]")
  promptUsed String?
  mime       String?
  data       Bytes?
  width      Int?
  height     Int?
  drawnAt    DateTime?

  @@unique([webtoonId, index])
  @@map("webtoon_panels")
}
