// 코디컴퍼챗 Prisma 스키마
// 원본: CodiComperChat_project_plan.md §10 2번 "Prisma 스키마: User, Character, Campaign, Session, Message, State"
// 테이블명 확정은 Prisma 단계에서 한다 (계획서 §7.5). 여기서는 core 6모델만 다룬다.
// LoreEntry / MemoryChunk는 §10 2번 범위 밖 — 이후 단계에서 추가한다.

generator client {
  provider = "prisma-client-js"
}

// 연결 문자열은 schema.prisma가 아니라 prisma.config.ts에서 관리한다 (Prisma 7)
datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  displayName  String
  // 소셜 로그인 등 비밀번호 없는 계정도 담을 수 있게 nullable (인증 벤더 미정)
  passwordHash String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  campaigns    Campaign[]
  personas     UserPersona[]

  @@map("users")
}

// 유저가 연기하는 주인공(프로필 캐릭터). 본인만 보고 쓴다 — 공유·마켓은 v1 범위 밖 (기획서 §9.2)
model UserPersona {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("user_personas")
}

/// 캐릭터 카드. 필드는 계획서 §12.2 카드 핵심 항목과 1:1로 대응한다.
model Character {
  id                    String     @id @default(cuid())
  name                  String     @unique
  oneLiner              String
  role                  String
  addressing            String
  personalityAxes       String
  speechStyle           String
  knows                 String
  unknown               String
  goal                  String
  conflictSeed          String
  secret                String
  secretUnlockCondition String
  openingScene          String
  /// 신체·직업 등 카드 밖 부가 프로필. 캐릭터마다 있을 수도, 없을 수도 있다
  profile               Json?
  published             Boolean    @default(false)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  campaigns             Campaign[]

  @@map("characters")
}

enum CampaignStatus {
  ACTIVE
  CLOSED
}

model Campaign {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId    String
  character      Character      @relation(fields: [characterId], references: [id])
  title          String
  status         CampaignStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  state          CampaignState?
  sessions       Session[]
  memories       MemoryChunk[]
  /// 이 시각까지의 메시지는 기억으로 정리했다. 그 뒤 메시지가 쌓이면 다음 정리를 한다
  memorizedUntil DateTime?

  // 유저×캐릭터 대화를 찾는 경로 (대화는 캐릭터마다 하나)
  @@index([userId, characterId])
  @@map("campaigns")
}

/// §13.3~13.4 캠페인 상태 — 관계·훅·다음 회차 브리핑
model CampaignState {
  id                  String   @id @default(cuid())
  campaignId          String   @unique
  campaign            Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// 친밀도 0(처음 만남)~100(각별함). 유저가 캐릭터 상태설정에서 조정한다
  relationshipValue   Int      @default(0)
  relationshipNote    String?
  /// 이 대화에서 캐릭터가 유저를 부르는 호칭. 비어 있으면 캐릭터 카드의 호칭 규칙을 따른다
  userNickname        String?
  openHooks           Json     @default("[]")
  unlockedSecrets     Json     @default("[]")
  briefForNextSession String?
  updatedAt           DateTime @updatedAt

  @@map("campaign_states")
}

enum SessionStatus {
  OPEN
  CLOSED
}

model Session {
  id           String        @id @default(cuid())
  campaignId   String
  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  index        Int
  status       SessionStatus @default(OPEN)
  startedAt    DateTime      @default(now())
  closedAt     DateTime?
  summaryBrief String?
  messages     Message[]

  @@unique([campaignId, index])
  @@map("sessions")
}

enum MessageRole {
  USER
  CHARACTER
  SYSTEM
}

model Message {
  id        String      @id @default(cuid())
  sessionId String
  session   Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  /// 유저 메시지를 보낼 때 쓴 내 프로필 캐릭터 이름 (프로필을 나중에 지우거나 바꿔도 기록은 그대로 남긴다)
  speaker   String?
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
  @@map("messages")
}

/// §7.5 MemoryChunk — 지난 대화에서 캐릭터가 기억할 내용을 요약한 짧은 문장.
/// 원문(Message)과 분리해 두고, 매 턴 관련 있는 것만 골라 컨텍스트에 넣는다. 임베딩은 나중에 붙인다
model MemoryChunk {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())

  @@index([campaignId, createdAt])
  @@map("memory_chunks")
}
