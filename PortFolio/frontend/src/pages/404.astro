---
import Base from "../layouts/Base.astro";
import { toc } from "../lib/content";
---

<Base title="페이지를 찾을 수 없어요" description="찾는 페이지가 없습니다. 포트폴리오의 다른 페이지로 이동해 보세요.">
  <section class="container nf">
    <p class="eyebrow">404 · Not found</p>
    <h1>이 주소에는 페이지가 없어요</h1>
    <p class="lead">주소가 바뀌었거나 잘못 입력됐을 수 있어요. 아래에서 둘러볼 곳을 골라 주세요.</p>
    <ul class="links">
      <li><a class="btn" href="/">처음으로</a></li>
      {toc.map((t) => <li><a href={`/${t.slug}`}>{t.no} {t.title}</a></li>)}
      <li><a href="/chat">AI 가이드에게 물어보기</a></li>
      <li><a href="/files">문서 내려받기</a></li>
    </ul>
  </section>
</Base>

<style>
  .nf { padding: 5rem 0 6rem; }
  .nf h1 { margin: 0.4rem 0 0.8rem; }
  .lead { color: var(--muted, inherit); max-width: 40rem; }
  .links { list-style: none; padding: 0; margin: 1.6rem 0 0; display: flex; flex-wrap: wrap; gap: 0.6rem 1.2rem; }
</style>
