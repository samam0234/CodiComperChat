# docker-compose.yml 값. .env로 복사해 채운다(.env는 git에 올라가지 않는다). 비밀값은 채팅·커밋에 붙이지 않는다.

# API 주소. 도메인이 없으면 IP로 풀리는 sslip.io 이름을 쓸 수 있다(예: portfolio-api.1-2-3-4.sslip.io)
API_DOMAIN=
# 프론트(Astro) 주소들, 쉼표로 (CORS)
FRONTEND_ORIGINS=https://codicomperchat-portfolio.vercel.app

# 비밀값: openssl rand -hex 64 / openssl rand -hex 32
SECRET_KEY_BASE=
AI_INTERNAL_TOKEN=

# Ollama가 이 기계에 없으면 주소를 준다(예: http://192.168.0.10:11434). --profile ollama면 그대로 둔다
OLLAMA_BASE_URL=http://ollama:11434
CHAT_MODEL=gemma4:e4b
FALLBACK_MODEL=gemma4:e4b
