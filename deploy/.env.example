# 운영 값. deploy/.env로 복사해 채운다 (.env는 git에 올라가지 않는다).
# 비밀값 만들기: node scripts/generate-prod-secrets.mjs  — 개발 값을 재사용하지 않는다.

# 도메인 (DNS A 레코드가 이 서버를 가리켜야 인증서가 나온다)
WEB_DOMAIN=example.com
CONSOLE_DOMAIN=console.example.com
ACME_EMAIL=ops@example.com

# 운영 콘솔을 열 IP. 앱용은 쉼표로 구분, Caddy용은 공백으로 구분(CIDR 가능)
CONSOLE_IP_ALLOWLIST=203.0.113.10
CONSOLE_CADDY_ALLOW=203.0.113.10

# 데이터베이스
POSTGRES_USER=codicomperchat
POSTGRES_PASSWORD=
POSTGRES_DB=codicomperchat

# 비밀값 (generate-prod-secrets.mjs)
AUTH_SECRET=
AI_SERVICE_TOKEN=

# 메일 (없으면 시작하지 않는다: 인증·재설정 메일이 필수다)
MAIL_SMTP_URL=
MAIL_FROM=코디컴퍼챗 <no-reply@example.com>

# 결제 (보류 중이면 비워 둔다. 비어 있으면 결제 화면이 열리지 않는다)
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=

# 프리미엄 모델(Claude·Grok). 실제 돈이 나간다. 켜기 전에 각 콘솔에서 월 사용 한도를 먼저 건다
# 여는 공급자: anthropic, xai 중 쉼표로. 비우면 "준비 중"
PREMIUM_PROVIDERS=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# GPU 서버
# 체크포인트 두 파일이 있는 서버 폴더 (animagine-xl-4.0-opt.safetensors, v1-5-pruned-emaonly.safetensors)
SD_MODEL_HOST_DIR=/srv/codicomperchat/models
OLLAMA_MODEL=gemma4:e4b
# 그래픽 메모리 8GB 이하면 1
SD_OFFLOAD=
AI_CONCURRENCY=2

# 포트 (보통 그대로)
HTTP_PORT=80
HTTPS_PORT=443
