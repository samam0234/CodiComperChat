# Oracle VM의 운영 값. deploy/oracle/.env로 복사해 채운다 (.env는 git에 올라가지 않는다).
# 비밀값 만들기: node scripts/generate-prod-secrets.mjs  — 개발 값을 재사용하지 않는다.
# WEB_PROXY_TOKEN은 아무 긴 무작위 값(32자 이상). 같은 값을 Vercel 웹 프로젝트의 환경변수에도 넣는다.

# API 도메인 (DNS A 레코드가 이 VM의 공인 IP를 가리켜야 인증서가 나온다). 무료면 duckdns 같은 서브도메인도 된다
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
# Vercel에 올린 웹 주소 (예: https://codicomperchat.vercel.app 또는 연결한 도메인)
WEB_BASE_URL=https://example.vercel.app
WEB_PROXY_TOKEN=

# 데이터베이스
POSTGRES_USER=codicomperchat
POSTGRES_PASSWORD=
POSTGRES_DB=codicomperchat

# 비밀값 (generate-prod-secrets.mjs)
AUTH_SECRET=
AI_SERVICE_TOKEN=

# AI 서버 주소. 비워 두면 이 VM의 ai(http://ai:8000, 프로필 free-api·fallback·cpu-ai).
# GPU 기계(deploy/ai-node)를 Tailscale로 붙이면 그 기계 주소: http://100.x.y.z:8000
AI_BASE_URL=

# --- 대화 모델: 무료 호스팅 API (프로필 free-api) ---
# OpenAI 호환 주소·키·모델. 키는 비밀값이니 이 파일(.env, git 제외)에만 적는다. 안내 HTML 4단계에서 발급한다
#  NVIDIA NIM        LLM_API_BASE=https://integrate.api.nvidia.com/v1   LLM_API_MODEL=google/gemma-4-31b-it
#  Google AI Studio  LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai   LLM_API_MODEL=gemma-4-31b-it
#  OpenRouter(예비)  LLM_API_BASE=https://openrouter.ai/api/v1          LLM_API_MODEL=google/gemma-4-31b-it:free
# openai: 무료 API (free-api, fallback). ollama: API 없이 이 VM의 Ollama만 (cpu-ai)
LLM_BACKEND=openai
LLM_API_BASE=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_API_MODEL=google/gemma-4-31b-it
# 프로필 fallback을 함께 쓸 때 1 (API가 막히면 이 VM의 Ollama gemma4:e4b가 대신 답한다)
LLM_FALLBACK_OLLAMA=
# API가 응답하는 최대 시간(초)
LLM_API_TIMEOUT_SECONDS=120

# 타임아웃 사슬 (ms). Vercel 함수 상한 300초보다 AI_TIMEOUT_MS가 짧아야 이용자에게 "늦어 멈췄어요" 안내가 간다
AI_TIMEOUT_MS=280000
AI_BACKGROUND_TIMEOUT_MS=900000
AI_QUEUE_WAIT_MS=120000
# 동시에 보내는 AI 호출 수. 무료 API는 분당 한도(NIM 40)가 있어 2~4, CPU Ollama는 1
AI_CONCURRENCY=2

# fallback·cpu-ai 프로필에서만 쓰는 값 (VM의 Ollama)
OLLAMA_MODEL=gemma4:e4b
OLLAMA_READ_TIMEOUT_SECONDS=900

# 메일 (없으면 시작하지 않는다: 인증·재설정 메일이 필수다)
MAIL_SMTP_URL=
MAIL_FROM=코디컴퍼챗 <no-reply@example.com>

# 결제·프리미엄·성인 모드 (deploy/.env.example과 같은 뜻)
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=
PRO_CLICK=on
PREMIUM_PROVIDERS=
PREMIUM_MONTHLY_CREDITS=0
ADULT_MODE=off

HTTP_PORT=80
HTTPS_PORT=443
