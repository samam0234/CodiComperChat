# deploy/oracle/.env로 복사해 채운다 (.env는 git에 올라가지 않는다).
# 비밀값: node scripts/generate-prod-secrets.mjs — 개발 값을 재사용하지 않는다.

# 도메인이 없을 때는 sslip.io가 IP를 그대로 이름으로 풀어 준다 (인증서도 나온다).
# 도메인을 사면 A 레코드를 서버 IP로 돌리고 이 값만 바꾼다.
API_DOMAIN=api.168-110-61-178.sslip.io

POSTGRES_USER=codicomperchat
POSTGRES_PASSWORD=
POSTGRES_DB=codicomperchat

AUTH_SECRET=
AI_SERVICE_TOKEN=

# 웹을 올린 주소 (메일 속 링크에 쓰인다). 아직 없으면 비워 둔다
WEB_BASE_URL=
MAIL_SMTP_URL=
MAIL_FROM=

PRO_CLICK=on
ADULT_MODE=off

# AI를 같은 VM에 올릴 때 (docker-compose.ai.yml). 무료 API면 2, CPU Ollama만 쓰면 1
AI_CONCURRENCY=2
OLLAMA_MODEL=gemma4:e4b

# 무료 호스팅 API로 대화 (권장). 키는 build.nvidia.com에서 만들고 서버의 .env에만 적는다
LLM_BACKEND=openai
LLM_API_KEY=
