# AI 노드(GPU 기계)의 값. deploy/ai-node/.env로 복사해 채운다 (.env는 git에 올라가지 않는다).

# Oracle VM의 AI_SERVICE_TOKEN과 같은 값 (32자 이상)
AI_SERVICE_TOKEN=

# 대화 기본 모델. 그래픽 메모리 12GB면 gemma4:12b가 들어가지만 그림 엔진과 번갈아 쓴다
OLLAMA_MODEL=gemma4:12b
# 기동 때 미리 올릴 모델(쉼표). 비우면 OLLAMA_MODEL
OLLAMA_WARMUP_MODELS=
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=1
OLLAMA_READ_TIMEOUT_SECONDS=600

# 8000을 어느 주소에 열까. Linux 서버면 이 기계의 Tailscale 주소(예: 100.101.102.103)로 묶는 것이 가장 안전하다.
# Windows Docker Desktop은 특정 주소 묶기가 잘 안 되니 0.0.0.0으로 두고 방화벽에서 막는다
AI_BIND=0.0.0.0

# 그림 엔진 체크포인트 두 파일이 있는 폴더 (Windows 예: D:/vscode/CodiComperChat/services/ai/models)
SD_MODEL_HOST_DIR=/srv/codicomperchat/models
# 그래픽 메모리 8GB 이하면 1
SD_OFFLOAD=

ANTHROPIC_API_KEY=
XAI_API_KEY=
