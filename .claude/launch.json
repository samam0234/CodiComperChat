{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "PortFolio/frontend", "run", "dev", "--", "--port", "4321", "--host", "127.0.0.1"],
      "port": 4321
    },
    {
      "name": "portfolio-api",
      "runtimeExecutable": "ruby",
      "runtimeArgs": ["PortFolio/server/backend/bin/rails", "server", "-p", "3000", "-b", "127.0.0.1", "-C", "PortFolio/server/backend"],
      "port": 3000
    },
    {
      "name": "portfolio-ai",
      "runtimeExecutable": "PortFolio/server/ai_services/.venv/Scripts/python.exe",
      "runtimeArgs": ["PortFolio/server/ai_services/run.py"],
      "port": 5001
    }
  ]
}
